<Window x:Class="Datenlotsen.AddItem"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Datenlotsen"
        mc:Ignorable="d"
        Title="Add New Item" Height="450" Width="800">
    <Grid  Margin="10">
        <StackPanel>
            <!-- Add Item Form Section -->
            <Label Content="Item Name"/>

            <TextBox x:Name="NameTextBox"   Margin="10" Text="" Height="45" />
            <Label Content="Category"/>

            <TextBox x:Name="CategoryTextBox"  Text="" Margin="10" Height="45" />
            <Label Content="Quantity"/>

            <TextBox x:Name="StockTextBox" Margin="10"   Text="" PreviewTextInput="StockTextBox_PreviewTextInput" Height="45"/>
            <Label Content="Stock Availability"/>

            <ComboBox Width="Auto" MinWidth="120" Margin="0,0,10,0" x:Name="FilterComboBox" HorizontalAlignment="Stretch">
                <ComboBoxItem Content="In Stock" IsSelected="True" Tag="True"/>
                <ComboBoxItem Content="Out Of Stock" Tag="False"/>
            </ComboBox>
            <Button Content="Add Item"  Click="AddItemButton_Click" Margin="10"   Width="80" Height="30"/>
            <Button Content="Cancel"  Click="Cancel_Click" Margin="-185,-41,10,10"   Width="80" Height="30"/>
        </StackPanel>
    </Grid>
</Window>

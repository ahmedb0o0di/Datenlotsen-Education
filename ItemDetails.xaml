<Window x:Class="Datenlotsen.ItemDetails"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Item Details" Height="450" Width="800">
    <Grid Margin="10">
        <StackPanel>
            <TextBox x:Name="NameTextBox" Margin="10" />
            <TextBox x:Name="CategoryTextBox" Margin="10" />
            <TextBox x:Name="StockTextBox" Margin="10" />
            <ComboBox Width="Auto" MinWidth="120" Margin="0,0,10,0" x:Name="FilterComboBox" HorizontalAlignment="Stretch">
                <ComboBoxItem Content="In Stock"  Tag="True"/>
                <ComboBoxItem Content="Out Of Stock" Tag="False"/>
            </ComboBox>
            <Button Content="Save" Width="80" Height="30" Margin="10" Click="SaveButton_Click"/>
            <Button Content="Cancel" Width="80" Height="30" Margin="-185,-40,10,10" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>

<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:av="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="av" x:Name="Items_List" x:Class="Datenlotsen.MainWindow"
        Title="Items List" Height="450" Width="800"
     xmlns:local="clr-namespace:Datenlotsen.Converters">
    <Window.Resources>
        <!-- Reference to StockConverter -->
        <local:StockConverter x:Key="StockConverter" />
    </Window.Resources>
    <Grid Margin="10" x:Name="ItemListing">

        <!-- Define the row definitions for dynamic resizing -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!-- Row for the search and filter section -->
            <RowDefinition Height="Auto" />
            <!-- Row for the add item and buttons -->
            <RowDefinition Height="*" />
            <!-- Row for the inventory data grid -->
        </Grid.RowDefinitions>

        <!-- Search and Filter Section -->
        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,10" HorizontalAlignment="Stretch">
            <TextBox Width="Auto" MinWidth="150" Margin="0,0,10,0" x:Name="SearchTextBox" HorizontalAlignment="Stretch" />
            <ComboBox Width="Auto" MinWidth="120" Margin="0,0,10,0" x:Name="FilterComboBox" HorizontalAlignment="Stretch" >
                <ComboBoxItem Content="All" IsSelected="True" />
                <ComboBoxItem Content="In Stock" />
                <ComboBoxItem Content="Out of Stock" />
            </ComboBox>
            <Button Content="Search" Width="Auto" MinWidth="100" Click="SearchButton_Click" HorizontalAlignment="Stretch" />
            <Button Content="Add New Item" Width="Auto" MinWidth="100" Click="AddItem_Click" HorizontalAlignment="Stretch" Margin="20,0,0,0" BorderThickness="1,1,1,1" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center" Padding="20,1,20,1" />
        </StackPanel>

        <!-- Inventory Data Grid Section -->
        <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <DataGrid x:Name="InventoryDataGrid" AutoGenerateColumns="False" CanUserAddRows="False" 
                      RowDetailsVisibilityMode="Visible" SelectionMode="Extended" 
                      ItemsSource="{Binding InventoryItems}" GridLinesVisibility="None"
                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="150" />
                    <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="150" />
                    <DataGridTextColumn Header="Stock Quantity" Binding="{Binding StockQuantity}" Width="150" />
                    <DataGridTextColumn Header="Stock " Binding="{Binding Stock , Converter={StaticResource StockConverter}}" Width="150" />
                    <DataGridTextColumn Header="Last Updated" Binding="{Binding LastUpdated, StringFormat=MM/dd/yyyy HH:mm}" Width="150" />

                    <!-- Delete Button Column -->
                    <DataGridTemplateColumn Header="Actions">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="View / Edit" Width="Auto" Margin="5" Click="Details_Click" Tag="{Binding}" Padding="20,0,20,0" />
                                    <Button Content="Delete" Width="Auto" Margin="5" Click="DeleteButton_Click" Tag="{Binding}" Padding="20,0,20,0" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </ScrollViewer>



    </Grid>
</Window>
